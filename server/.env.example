# Puerto del servidor de la API
PORT=4000

# Conexión a PostgreSQL (docker-compose local por defecto)
DATABASE_URL=postgres://ecorecicla:ecorecicla@localhost:5432/ecorecicla

# Base de datos usada por la suite de pruebas (Jest + Supertest)
TEST_DATABASE_URL=postgres://ecorecicla:ecorecicla@localhost:5432/ecorecicla_test

# Secreto para firmar los JWT — cambiar en producción por un valor aleatorio largo
JWT_SECRET=cambia-este-secreto-en-produccion

# Expiración de los JWT
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (URL del cliente)
CORS_ORIGIN=http://localhost:5173
